{
  "name": "vortex-web",
  "version": "1.0.0",
  "description": "Landing page / portafolio para Vortex Web — agencia de desarrollo web, marketing digital e IA.",
  "private": true,
  "scripts": {
    "build": "npm run sass:build",
    "sass:build": "sass src/scss/main.scss:src/css/main.css --no-source-map",
    "sass:build:min": "sass src/scss/main.scss:src/css/main.css --style=compressed --no-source-map",
    "sass:watch": "sass --watch src/scss/main.scss:src/css/main.css",
    "dev": "vite src --host 0.0.0.0 --port 5500"
  },
  "devDependencies": {
    "sass": "^1.77.0",
    "vite": "^6.4.4"
  },
  "author": "",
  "license": "UNLICENSED"
}
